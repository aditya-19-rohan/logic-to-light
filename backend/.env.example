# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000

# MongoDB Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vitals-ledger?retryWrites=true&w=majority

# Comma-separated list of frontends allowed to call the API
CORS_ORIGIN=http://localhost:8080,https://your-app.vercel.app
